# 複製這份檔案為 .env（.env 已在 .gitignore，不會進版控），再依需要調整。

# --- PostgreSQL ---
POSTGRES_USER=projectc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=projectc_dev

# --- JWT ---
JWT_ISSUER=ProjectC.WebApi
JWT_AUDIENCE=ProjectC.Client
# 至少 32 字元，正式環境請改用 Secret Manager / Azure Key Vault 等機制注入，不要寫在這份檔案裡。
JWT_SIGNING_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30

# --- Auth (Refresh Token / Password Reset Token) ---
AUTH_REFRESH_TOKEN_EXPIRATION_DAYS=14
AUTH_PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=15

# --- Ticket Signing (電子票券 QR Code HMAC 簽章) ---
# 至少 32 字元，正式環境請改用 Secret Manager / Azure Key Vault 等機制注入，不要寫在這份檔案裡。
TICKET_SIGNING_KEY=change-me-to-a-random-string-at-least-32-chars

# --- 本機展示用初始資料（選填，只在 Development 執行）---
# 設定後 API 啟動時會確保這個 Admin 帳號存在，且是一個 Approved Organizer 的 Owner；
# 登入後到「我的主辦方」切換一次即可操作活動／場館後台。不設定就不建立任何資料。
# DEV_SEED_ADMIN_EMAIL=admin@local.dev
# DEV_SEED_ADMIN_PASSWORD=change-me-Passw0rd
# DEV_SEED_ORGANIZER_NAME=Demo Organizer

# --- 本機 port 覆寫（選填，跟本機其他服務衝突時再設）---
# DB_HOST_PORT=5432
# API_HOST_PORT=8080
# SEQ_HOST_PORT=8081
# WEB_HOST_PORT=5173

# 以下不在 compose 轉入，僅供部署到本機以外環境時參考（K8s 見 k8s/10-configmap.yaml 與 k8s/examples/secret.example.yaml）：
# AdminBootstrap__Email / AdminBootstrap__Password（非 Development 建立首位 Admin）、
# Captcha__VerificationMode（Production 禁止 AcceptAny）、Seq__ServerUrl、ConnectionStrings__Redis。
# 完整對照表見 docs/archive/2026-11-10-deployment-env-vars.md。

# --- pgAdmin（選填，只有你自己複製 docker-compose.override.yml.example 才會用到）---
# PGADMIN_EMAIL=admin@local.dev
# PGADMIN_PASSWORD=admin
# PGADMIN_HOST_PORT=5050
