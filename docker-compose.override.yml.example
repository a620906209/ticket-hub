# 本機專用的 docker compose override 範本。
# 複製這份檔案為 docker-compose.override.yml（該檔名已在 .gitignore，不會進版控），
# 執行 `docker compose up` 時會自動合併，不需要加 -f。
#
# 用途：跟別人共用的 docker-compose.yml 保持乾淨、大家都一樣；
# 這份 override 放「只有你自己需要」的東西，例如只有你自己會用的 GUI 工具。
#
# 注意：db / api 的對外 port 不要在這裡改——docker-compose.yml 的 ports 已經是
# `${DB_HOST_PORT:-5432}:5432` / `${API_HOST_PORT:-8080}:8080`，Compose 對同一個
# service 的 ports 清單是「合併」而非「取代」，在這裡再宣告一次會變成兩個 port 都對外開，
# 而不是換掉原本的。要換 port 請直接在你的 .env 設 DB_HOST_PORT / API_HOST_PORT。

services:
  # pgAdmin：本機用瀏覽器看 DB 的方便工具，非必要，不放進共用的 docker-compose.yml。
  pgadmin:
    image: dpage/pgadmin4:latest
    depends_on:
      - db
    environment:
      PGADMIN_DEFAULT_EMAIL: ${PGADMIN_EMAIL:-admin@local.dev}
      PGADMIN_DEFAULT_PASSWORD: ${PGADMIN_PASSWORD:-admin}
      PGADMIN_CONFIG_SERVER_MODE: "False"
    ports:
      - "${PGADMIN_HOST_PORT:-5050}:80"
    volumes:
      - pgadmin_data:/var/lib/pgadmin

volumes:
  pgadmin_data:
