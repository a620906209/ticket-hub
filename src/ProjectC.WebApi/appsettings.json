{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Seq": {
    "ServerUrl": ""
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 30
  },
  "Auth": {
    "RefreshTokenExpirationDays": 14,
    "PasswordResetTokenExpirationMinutes": 15
  },
  "OrderCleanup": {
    "IntervalSeconds": 300
  },
  "TicketSigning": {
    "SigningKey": ""
  },
  "RateLimiting": {
    "PermitLimit": 20,
    "WindowSeconds": 60
  },
  "PurchaseQueue": {
    "MaxConcurrentAdmittedBuyers": 50,
    "AdmissionTtlSeconds": 300,
    "PollingIntervalSeconds": 5
  }
}
